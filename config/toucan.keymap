#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

        behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <180>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                 &none &kp SQT       &kp COMMA &kp DOT &kp P &kp Y    &kp F &kp G &kp C &kp R &kp L       &none
                 &none &mt LCTRL A   &kp O     &kp E   &kp U &kp I    &kp D &kp H &kp T &kp N &mt RCTRL S &none
                 &none &mt LGUI SEMI &kp Q     &kp J   &kp K &kp X    &kp B &kp M &kp W &kp V &mt RGUI Z  &none
                               &kp LALT &lt 1 TAB &mt LSHIFT SPACE    &mt RSHIFT RETURN  &lt 2 ESC &mt RALT RG(SPACE)
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none &kp N7       &kp N8 &kp N9 &kp DEL &kp BSPC    &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none     &none
                &none &mt LCTRL N4 &kp N5 &kp N6 &none   &none       &kp PG_UP  &kp HOME     &kp UP       &kp END      &kp RCTRL &none
                &none &mt LGUI N1  &kp N2 &kp N3 &kp N0  &none       &kp PG_DN  &kp LEFT     &kp DOWN     &kp RIGHT    &kp RGUI  &none
                                                &none &none &none    &kp RSHIFT &lt 2 ESC &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none &kp EXCL        &kp AT   &kp POUND &kp DLLR &kp PRCNT    &kp CARET &kp AMPS &kp STAR &kp MINUS &kp UNDER       &none
                &none &mt LCTRL GRAVE &kp LPAR &kp LBRC  &kp LBKT &kp LT       &kp GT    &kp RBKT &kp RBRC &kp RPAR  &mt RCTRL EQUAL &none
                &none &mt LGUI TILDE  &none    &none     &none    &none        &kp QMARK &kp FSLH &kp PIPE &kp BSLH  &mt RGUI PLUS   &none
                                        &kp LALT &lt 1 TAB &mt LSHIFT SPACE    &none &none &none
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &none &kp F7       &kp F8 &kp F9 &kp F12 &none    &kp C_VOL_DN &kp C_VOL_UP &none &none &none     &none
                &none &mt LCTRL F4 &kp F5 &kp F6 &kp F11 &none    &none        &none        &none &none &kp RCTRL &none
                &none &mt LGUI F1  &kp F2 &kp F3 &kp F10 &none    &none        &none        &none &none &kp RGUI  &none
                                      &kp LALT &none &kp LSHIFT   &kp RET &mo 2 &kp RALT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans    &kp Q &kp W &kp E &kp R &kp T           &trans &trans &trans &trans &trans &trans
                &kp LCTRL &kp A &kp S &kp D &kp F &kp G           &trans &trans &trans &trans &trans &trans
                &trans    &kp Z &kp X &kp C &kp V &kp B           &trans &trans &trans &trans &trans &trans
                     &mkp MCLK &kp TAB &mt LSHIFT SPACE           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
